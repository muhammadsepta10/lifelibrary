# Postgres (URL pooled Neon). Kosong = PGlite lokal di .data/pglite
DATABASE_URL=
# Rahasia penanda tangan sesi (openssl rand -base64 32)
AUTH_SECRET=
# URL aplikasi (http://localhost:3000 saat dev, URL Vercel di produksi)
BETTER_AUTH_URL=
# Akun Pemilik tunggal, dipakai oleh `pnpm db:seed-owner`
OWNER_EMAIL=
OWNER_PASSWORD=
# Opsional (tiket berikutnya)
GOOGLE_BOOKS_API_KEY=
BLOB_READ_WRITE_TOKEN=
